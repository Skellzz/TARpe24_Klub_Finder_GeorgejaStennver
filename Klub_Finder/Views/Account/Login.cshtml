@model Klub_Finder.Models.LoginViewModel
<!DOCTYPE html>
<head>
    <meta charset="utf-8" />
    <link rel="stylesheet" type="text/style" href="~/css/index.css" />
    <title>Home page</title>
</head>
<body>
    <h1 class="display-4">Login</h1>

    <div asp-action="Login" method="post"></div>

    <form asp-action="Login" method="post">
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="nav-link text-light"></span>
        </div>
        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="form-control" />
            <span asp-validation-for="Password" class="nav-link text-light"></span>
        </div>
        <div class="form-group">
            <div class="form-check"
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary">Login</button>
     </form>
     @section Scripts {
            @{
                await Html.RenderPartialAsync("_ValidationScriptsPartial");
            }
        }
</body>