@model IEnumerable<Klub_Finder.Models.Klubi>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Nimi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Asukoht)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Kirjeldus)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pilt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.KontaktEmail)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Telefon)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nimi)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Asukoht)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Kirjeldus)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pilt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.KontaktEmail)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Telefon)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
