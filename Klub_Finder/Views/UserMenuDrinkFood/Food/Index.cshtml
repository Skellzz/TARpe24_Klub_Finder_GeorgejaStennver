@model IEnumerable<Klub_Finder.Models.Food>

@{
    ViewData["Title"] = "Toidud";
}

<div class="food-menu-box">
    <h1>TOIDUD</h1>

    <div class="food-grid">
        @foreach (var item in Model)
        {
            <div class="food-card" data-desc="@item.Description" data-price="@item.Price" data-name="@item.FoodName" data-img="@item.ImagePath" onclick="openModal(this)">
                <div class="food-image-box">
                    @if (!string.IsNullOrEmpty(item.ImagePath))
                    {
                        <img src="@item.ImagePath" alt="@item.FoodName" />
                    }
                </div>

                <h3>@item.FoodName</h3>
                <p>@item.Price €</p>
            </div>
        }
    </div>

    <a asp-controller="FoodAndDrinks" asp-action="Index" class="back-btn">
        BACK
    </a>
</div>

<div class="food-modal-backdrop" id="foodModal" onclick="closeModal(event)">
    <div class="food-modal-content">
        <span class="modal-close" onclick="closeModal(event)">&times;</span>
        <div class="modal-layout">
            <div class="modal-info-side">
                <h2 id="modalName"></h2>
                <div id="modalPrice" class="modal-price"></div>
                <hr class="modal-divider" />
                <p id="modalDesc" class="modal-description"></p>
            </div>
            <div class="modal-image-side">
                <img id="modalImg" src="" alt="" />
            </div>
        </div>
    </div>
</div>

<style>
    .food-menu-box {
        width: 90%;
        margin: 40px auto;
        min-height: 700px;
        border: 1px solid white;
        background: linear-gradient(to bottom, #94147d, #252525 55%);
        padding: 10px 40px 30px 40px;
        color: white;
        display: flex;
        flex-direction: column;
    }

        .food-menu-box h1 {
            text-align: center;
            font-size: 22px;
            letter-spacing: 4px;
            margin-bottom: 50px;
            font-weight: 300;
        }

    .food-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 45px 80px;
        justify-items: center;
    }

    .food-card {
        width: 170px;
        min-height: 230px;
        border: 1px solid white;
        text-align: center;
        padding: 10px;
        background: rgba(0, 0, 0, 0.25);
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

        .food-card:hover {
            transform: scale(1.05);
            border-color: #ff00b7;
        }

    .food-image-box {
        width: 145px;
        height: 100px;
        border: 1px solid white;
        margin: 0 auto 10px auto;
        background: transparent;
    }

        .food-image-box img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .food-card h3 {
        font-size: 14px;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .food-card p {
        font-size: 12px;
        margin: 3px 0;
        text-transform: uppercase;
    }

    .back-btn {
        margin-top: auto;
        margin-bottom: 20px;
        width: fit-content;
        padding: 8px 40px;
        border: 1px solid #ff00b7;
        border-radius: 25px;
        color: white;
        text-decoration: none;
        font-size: 22px;
    }

        .back-btn:hover {
            color: white;
            background-color: #ff00b7;
        }

    .food-modal-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.7);
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
        z-index: 9999;
    }

</style>
