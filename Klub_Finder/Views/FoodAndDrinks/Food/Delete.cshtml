@model Klub_Finder.Models.Food
@{
    ViewData["Title"] = "Delete Food";
}

<div class="container mt-5">
    <h1>Delete Drink</h1>

    <h4>Are you sure you want to delete this drink?</h4>

    <hr />

    <dl class="row">
        <dt class="col-sm-3">Food Name</dt>
        <dd class="col-sm-9">@Model.FoodName</dd>

        <dt class="col-sm-3">Description</dt>
        <dd class="col-sm-9">@Model.Description</dd>

        <dt class="col-sm-3">Price</dt>
        <dd class="col-sm-9">@Model.Price €</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>