@model IEnumerable<Klub_Finder.Models.Food>

@{
    ViewData["Title"] = "Food";
}

<div class="container">
    <h1>Food</h1>
    <p>Tere tulemast toidu lehele! Siin saad näha kõiki toite mida klubid pakuvad.</p>

    <a asp-controller="Food" asp-action="Create" class="btn btn-primary mb-3">
        Add Food
    </a>

    <table class="table">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.FoodName</td>
                    <td>@item.Description</td>
                    <td>@item.Price €</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>