@model Klub_Finder.Models.Settings

@{
    ViewData["Title"] = "Settings";
}

<style>
    h1 {
        font-size: 28px;
        margin-bottom: 25px;
    }

    label {
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 6px;
        display: block;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-control {
        font-size: 14px;
        padding: 8px 10px;
        height: 38px;
    }

    .btn {
        font-size: 14px;
        padding: 8px 18px;
    }

    .image-upload-box {
        width: 220px;
        height: 320px;
        border: 2px dashed #999;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #f8f8f8;
        transition: 0.3s;
        padding: 15px;
    }

        .image-upload-box:hover {
            border-color: #0000FF;
            background-color: #f0f4ff;
        }

    .form-control-file {
        border: none;
        background: transparent;
        width: 100%;
    }
</style>

<h1>Settings</h1>

<form asp-controller="Settings" asp-action="Index" method="post">

    <div class="form-group">
        <label asp-for="Image" class="control-label">Profile Picture</label>

        <div class="image-upload-box">
            <input asp-for="Image" type="file" class="form-control-file" accept="image/*" />
        </div>

        <span asp-validation-for="Image" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>First Name</label>
        <input asp-for="FirstName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Last Name</label>
        <input asp-for="LastName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Nick Name</label>
        <input asp-for="NickName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Age</label>
        <input asp-for="Age" class="form-control" />
    </div>

    <br />
    <h1>Contacts</h1>
    <br />
    <div class="form-group">
        <label>Phone</label>
        <input asp-for="Phone" class="form-control" type="Phone" />
    </div>

    <div class="form-group">
        <label>Email</label>
        <input asp-for="Email" class="form-control" type="email" />
    </div>

    <div class="form-group">
        <label>Password</label>
        <input asp-for="Password" class="form-control" type="password" />
    </div>

    <br />
    <h1>Location</h1>
    <div class="form-group">
        <label>City</label>
        <input asp-for="City" class="form-control" />
    </div>

    <br />

    <a asp-action="Home" class="btn" style="background-color:#0000FF	; color:white;">
        Back
    </a>
    
    <button type="submit" class="btn" style="background-color: #0000FF; color:white;">
        Save Settings
    </button>

</form>
