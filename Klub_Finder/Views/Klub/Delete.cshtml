@model Klub_Finder.Models.Klubi

@{
    ViewData["Title"] = "Delete Club";
}

<h1>Delete Club</h1>

<h3>Are you sure you want to delete this club?</h3>

<div class="card" style="width: 22rem;">
    @if (!string.IsNullOrEmpty(Model.ImagePath))
    {
        <img src="@Model.ImagePath" class="card-img-top" style="height:200px; object-fit:cover;" />
    }

    <div class="card-body">
        <h5 class="card-title">@Model.ClubName</h5>
        <p class="card-text">@Model.Description</p>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>