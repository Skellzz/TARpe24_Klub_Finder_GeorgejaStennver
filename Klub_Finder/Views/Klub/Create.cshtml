@model Klub_Finder.Models.Klubi

@{
    ViewData["Title"] = "Create Club";
}

<h1>Create Club</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label asp-for="ClubName" class="form-label"></label>
        <input asp-for="ClubName" class="form-control" />
        <span asp-validation-for="ClubName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="5"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="City" class="form-label"></label>
        <input asp-for="City" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DistanceKm" class="form-label"></label>
        <input asp-for="DistanceKm" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="Is18Plus" class="form-check-input" />
        <label asp-for="Is18Plus" class="form-check-label">18+</label>
    </div>

    <div class="form-check mb-3">
        <input asp-for="HasLiveMusic" class="form-check-input" />
        <label asp-for="HasLiveMusic" class="form-check-label">Live Music</label>
    </div>

    <div class="mb-3">
        <label asp-for="MusicType" class="form-label"></label>
        <input asp-for="MusicType" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Club Image</label>
        <input asp-for="ImageFile" type="file" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Create Club</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>