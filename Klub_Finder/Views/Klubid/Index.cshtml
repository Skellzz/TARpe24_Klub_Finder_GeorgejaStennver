@model IEnumerable<Klub_Finder.Models.Klubi>

@{
    ViewData["Title"] = "Klubid";
    var klubid = Model.ToList();
}

<style>
    .filter-box {
        width: 450px;
        margin: 20px auto;
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        justify-content: center;
    }

        .filter-box input,
        .filter-box select {
            padding: 10px;
            border-radius: 8px;
            border: 1px solid white;
            width: 190px;
        }

        .filter-box button,
        .filter-box a {
            padding: 10px 18px;
            border-radius: 8px;
            background: #51245a;
            color: white;
            border: 1px solid white;
            text-decoration: none;
            cursor: pointer;
        }

    .klub-container {
        width: 450px;
        margin: auto;
        padding: 25px;
        background: linear-gradient(180deg,#1f3560,#51245a);
        min-height: 750px;
        border: 2px solid white;
        border-radius: 10px;
    }

    .klub-card {
        display: none;
        flex-direction: column;
        gap: 20px;
    }

        .klub-card.active {
            display: flex;
        }

    .image-container {
        width: 100%;
        height: 320px;
        background: black;
        border: 2px solid white;
    }

    .klub-image {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .klub-name {
        background: black;
        color: white;
        text-align: center;
        font-size: 32px;
        padding: 15px;
        border: 2px solid white;
    }

    .klub-description {
        background: black;
        color: white;
        text-align: center;
        font-size: 22px;
        min-height: 120px;
        padding: 20px;
        border: 2px solid white;
    }

    .klub-info {
        background: black;
        color: white;
        padding: 15px;
        border: 2px solid white;
        text-align: center;
    }

    .action-buttons {
        display: flex;
        justify-content: space-around;
        margin-top: 10px;
    }

    .action-btn {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        border: 2px solid white;
        font-size: 35px;
        cursor: pointer;
    }

    .dislike {
        background-color: #dc3545;
        color: white;
    }

    .heart {
        background-color: white;
        color: red;
    }

    .like {
        background-color: #28a745;
        color: white;
    }
</style>

<form method="get" class="filter-box">
    <input type="text" name="city" placeholder="Linn" value="@Context.Request.Query["city"]" />

    <input type="number" name="maxDistance" placeholder="Max kaugus km" value="@Context.Request.Query["maxDistance"]" />

    <select name="is18Plus">
        <option value="">18+ või mitte</option>
        <option value="true">18+</option>
        <option value="false">Alla 18 lubatud</option>
    </select>

    <select name="hasLiveMusic">
        <option value="">Live music?</option>
        <option value="true">Jah</option>
        <option value="false">Ei</option>
    </select>

    <input type="text" name="musicType" placeholder="Muusika tüüp" value="@Context.Request.Query["musicType"]" />

    <button type="submit">Otsi</button>
    <a asp-action="Index">Tühjenda</a>
</form>

@if (klubid.Any())
{
    <div class="klub-container">
        @for (int i = 0; i < klubid.Count; i++)
        {
            var klub = klubid[i];

            <div class="klub-card @(i == 0 ? "active" : "")">
                <div class="image-container">
                    <img src="@klub.ImagePath" class="klub-image" />
                </div>

                <div class="klub-name">
                    @klub.ClubName
                </div>

                <div class="klub-description">
                    @klub.Description
                </div>

                <div class="klub-info">
                    <p>Linn: @klub.City</p>
                    <p>Kaugus: @klub.DistanceKm km</p>
                    <p>18+: @(klub.Is18Plus ? "Jah" : "Ei")</p>
                    <p>Live Music: @(klub.HasLiveMusic ? "Jah" : "Ei")</p>
                    <p>Muusika: @klub.MusicType</p>
                </div>

                <div class="action-buttons">
                    <button class="action-btn dislike" onclick="dislikeClub(@klub.Id)">✖</button>
                    <button class="action-btn heart" onclick="heartClub(@klub.Id)">❤</button>
                    <button class="action-btn like" onclick="likeClub(@klub.Id)">✔</button>
                </div>
            </div>
        }

        <h2 id="noMoreClubs" style="display:none; color:white; text-align:center;">
            Rohkem klubisid pole.
        </h2>
    </div>
}
else
{
    <h2 style="text-align:center;">Klubisid ei leitud.</h2>
}

<script>
    let currentCard = 0;

    function showNextClub() {
        const cards = document.querySelectorAll(".klub-card");

        if (cards[currentCard]) {
            cards[currentCard].classList.remove("active");
        }

        currentCard++;

        if (cards[currentCard]) {
            cards[currentCard].classList.add("active");
        } else {
            document.getElementById("noMoreClubs").style.display = "block";
        }
    }

    function likeClub(id) {
        fetch('/Klubid/Like?id=' + id, {
            method: 'POST'
        });

        showNextClub();
    }

    function dislikeClub(id) {
        fetch('/Klubid/Dislike?id=' + id, {
            method: 'POST'
        });

        showNextClub();
    }

    function heartClub(id) {
        fetch('/Klubid/SuperLike?id=' + id, {
            method: 'POST'
        });

        showNextClub();
    }
</script>